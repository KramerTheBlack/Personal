---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Chart.Name }}-alfresco
  namespace: {{ .Release.Namespace }}
  labels:
    app: {{ .Chart.Name }}-alfresco
    name: {{ .Chart.Name }}-alfresco
spec:
  clusterIP: "{{tpl .Values.global.clusterips.sol6.alfresco .}}"
  ports:
  - name: "8080"
    port: 8080
    targetPort: 8080
  - name: "10054"
    port:  10054
    targetPort: 10054
  selector:
    app: {{ .Chart.Name }}-alfresco
    name: {{ .Chart.Name }}-alfresco
  type: NodePort
status:
  loadBalancer: {}
